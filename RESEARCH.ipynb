        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.model_selection import train_test_split\n",
        "import tensorflow as tf\n",
        "from tensorflow.keras.callbacks import EarlyStopping\n",
        "import keras_tuner as kt\n",
        "\n",
        "df_positives = df_events_context[df_events_context['target'] == 1]\n",
        "num_positives = len(df_positives)\n",
        "df_negatives_sampled = df_events_context[df_events_context['target'] == 0].sample(n=num_positives * 3, random_state=42)\n",
        "\n",
        "df_balanced = pd.concat([df_positives, df_negatives_sampled]).sample(frac=1, random_state=42).reset_index(drop=True)\n",
        "print(f\"Original Dataset Size: {len(df_events_context)}\")\n",
        "print(f\"New Balanced Dataset Size: {len(df_balanced)} (Much faster and precise to train!)\")\n",
        "\n",
        "X_dict_bal = {\n",
        "    'user_id': df_balanced['visitorid'].values,\n",
        "    'target_item_id': df_balanced['itemid'].values,\n",
        "    'item_sequence': df_balanced[['item_minus_3', 'item_minus_2', 'item_minus_1']].values,\n",
        "    'time_of_day': df_balanced['time_of_day_idx'].values,\n",
        "    'is_weekend': df_balanced['is_weekend'].values,\n",
        "    'hour_sin': df_balanced['hour_sin'].values,\n",
        "    'hour_cos': df_balanced['hour_cos'].values\n",
        "}\n",
        "y_bal = df_balanced['target'].values\n",
        "\n",
        "indices = np.arange(len(y_bal))\n",
        "train_idx, val_idx = train_test_split(indices, test_size=0.2, random_state=42, stratify=y_bal)\n",
        "\n",
        "X_train_bal = {key: val[train_idx] for key, val in X_dict_bal.items()}\n",
        "y_train_bal = y_bal[train_idx]\n",
