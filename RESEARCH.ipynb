        "        iso_input['is_weekend'] = np.zeros_like(iso_input['is_weekend'])\n",
        "\n",
        "    return iso_input\n",
        "\n",
        "prob_hybrid = final_robust_model.predict(get_isolated_input(\"full\"), verbose=0)[0][0] * 100\n",
        "prob_collab = final_robust_model.predict(get_isolated_input(\"collab\"), verbose=0)[0][0] * 100\n",
        "prob_content = final_robust_model.predict(get_isolated_input(\"content\"), verbose=0)[0][0] * 100\n",
        "\n",
        "print(f\"\\nMODEL BRAIN PREDICTIONS (Ablation Results):\")\n",
