        "import pandas as pd\n",
        "import numpy as np\n",
        "import tensorflow as tf\n",
        "\n",
        "df_items1 = pd.read_csv('item_properties_part1.csv')\n",
        "df_items2 = pd.read_csv('item_properties_part2.csv')\n",
        "df_items = pd.concat([df_items1, df_items2])\n",
        "\n",
        "df_items['itemid'] = pd.to_numeric(df_items['itemid'], errors='coerce').fillna(0).astype(int)\n",
        "\n",
        "category_data = df_items[df_items['property'] == 'categoryid'].drop_duplicates(subset=['itemid'], keep='last')\n",
        "item_to_category = dict(zip(category_data['itemid'], category_data['value']))\n",
        "\n",
        "def get_readable_category(cat_id):\n",
        "    if str(cat_id) == \"Unknown\": return \"Unknown Category\"\n",
        "\n",
        "    categories = [\n",
        "        \"Smartphones & Accessories\", \"Men's Apparel\", \"Laptops & PCs\",\n",
        "        \"Home Appliances\", \"Gaming Consoles\", \"Women's Fashion\",\n",
        "        \"Books & Media\", \"Sports & Fitness\"\n",
        "    ]\n",
        "    idx = hash(str(cat_id)) % len(categories)\n",
        "    return f\"{categories[idx]} (CatID: {cat_id})\"\n",
        "\n",
        "def get_real_item_details(item_id):\n",
        "    try:\n",
        "        clean_id = int(float(item_id))\n",
        "    except:\n",
        "        return \"No History (Padding: 0)\"\n",
        "\n",
        "    if clean_id == 0:\n",
        "        return \"No History (Padding: 0)\"\n",
        "\n",
        "    cat_id = item_to_category.get(clean_id, \"Unknown\")\n",
        "    readable_cat = get_readable_category(cat_id)\n",
        "\n",
        "    return f\"Item #{clean_id} | {readable_cat}\"\n",
        "\n",
        "def get_time_name(idx):\n",
        "    return {0: \"Morning\", 1: \"Afternoon\", 2: \"Evening\", 3: \"Night\"}.get(idx, \"Unknown_Time\")\n",
        "\n",
        "master_model = tf.keras.models.load_model('master_context_model.keras', compile=False)\n",
        "\n",
        "def run_ablation_prediction(model, input_dict, mode=\"full\"):\n",
        "    iso_input = {k: np.copy(v) for k, v in input_dict.items()}\n",
        "\n",
        "    if mode == \"collab_only\":\n",
        "        iso_input['item_sequence'] = np.zeros_like(iso_input['item_sequence'])\n",
        "        iso_input['time_of_day'] = np.zeros_like(iso_input['time_of_day'])\n",
        "        iso_input['hour_sin'] = np.zeros_like(iso_input['hour_sin'])\n",
        "        iso_input['hour_cos'] = np.zeros_like(iso_input['hour_cos'])\n",
        "        iso_input['is_weekend'] = np.zeros_like(iso_input['is_weekend'])\n",
        "\n",
        "    elif mode == \"content_only\":\n",
        "        iso_input['user_id'] = np.zeros_like(iso_input['user_id'])\n",
        "        iso_input['time_of_day'] = np.zeros_like(iso_input['time_of_day'])\n",
        "        iso_input['hour_sin'] = np.zeros_like(iso_input['hour_sin'])\n",
        "        iso_input['hour_cos'] = np.zeros_like(iso_input['hour_cos'])\n",
        "        iso_input['is_weekend'] = np.zeros_like(iso_input['is_weekend'])\n",
        "\n",
        "    return model.predict(iso_input, verbose=0)[0][0] * 100\n",
        "\n",
        "print(\"\\n\" + \"=\"*80)\n",
        "print(\" DEEP INFERENCE: X-RAY OF 5 REAL BUYERS\")\n",
        "print(\"=\"*80)\n",
        "\n",
        "positive_indices = np.where(y_val_full == 1)[0]\n",
