      "source": [
        "!pip install pdfkit\n",
        "import pandas as pd\n",
        "from ydata_profiling import ProfileReport\n",
        "from ydata_profiling.config import Settings\n",
        "import pdfkit\n",
        "from google.colab import files\n",
        "\n",
        "\n",
        "df_events = pd.read_csv('events.csv')\n",
        "df_items1 = pd.read_csv('item_properties_part1.csv')\n",
        "df_items2 = pd.read_csv('item_properties_part2.csv')\n",
        "df_category = pd.read_csv('category_tree.csv')\n",
        "\n",
        "df_items = pd.concat([df_items1, df_items2])\n",
        "\n",
        "print(f\"Total Events loaded: {len(df_events)}\")\n",
        "print(f\"Total Items loaded: {len(df_items)}\")\n",
        "\n",
        "profiling_config = Settings()\n",
        "profiling_config.html.style.theme = 'united'\n",
        "\n",
        "profile = ProfileReport(\n",
        "    df_events,\n",
        "    title=\"Retailrocket Events Full Data Profiling\",\n",
        "    explorative=True,\n",
        "    config=profiling_config\n",
        ")\n",
        "\n",
        "html_file = \"events_full_profiling_report.html\"\n",
        "profile.to_file(html_file)\n",
        "\n",
        "pdf_file = \"events_full_profiling_report.pdf\"\n",
        "config = pdfkit.configuration(wkhtmltopdf=\"/usr/bin/wkhtmltopdf\")\n",
        "pdfkit.from_file(html_file, pdf_file, configuration=config)\n",
        "\n",
        "files.download(html_file)\n",
        "files.download(pdf_file)"
      ],
