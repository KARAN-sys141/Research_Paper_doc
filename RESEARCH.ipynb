        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "p = np.linspace(0.01, 0.99, 100)\n",
        "\n",
        "bce_loss = -np.log(p)\n",
        "\n",
        "gamma = 2.0\n",
        "focal_loss = -(1 - p)**gamma * np.log(p)\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "plt.plot(p, bce_loss, label='Standard Cross-Entropy (BCE)', color='#ff0066', linestyle='--', linewidth=2)\n",
        "plt.plot(p, focal_loss, label=f'Focal Loss ($\\gamma={gamma}$)', color='#00ccff', linewidth=3)\n",
        "\n",
        "plt.title('Loss Function Comparison: BCE vs. Focal Loss', fontsize=14, fontweight='bold')\n",
        "plt.xlabel('Model Predicted Probability ($p_t$)', fontsize=12)\n",
        "plt.ylabel('Loss Value', fontsize=12)\n",
        "plt.axvline(x=0.8, color='grey', linestyle=':', alpha=0.6)\n",
        "plt.text(0.82, 1.5, 'Easy Example\\n(Loss $\\\\approx 0$ for FL)', color='grey', fontsize=10)\n",
        "\n",
