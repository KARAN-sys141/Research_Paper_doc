        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import tensorflow as tf\n",
        "\n",
        "loaded_master_model = tf.keras.models.load_model('master_context_model.keras')\n",
        "\n",
        "def grandmaster_top10_xray(df, model, specific_user_id=None, pool_size=1000):\n",
        "    \"\"\"\n",
        "    Takes a User ID, scans a pool of items, and returns the Top 10 recommendations\n",
        "    from 3 different perspectives (Content, Collab, Hybrid).\n",
        "    \"\"\"\n",
        "    if specific_user_id is None:\n",
        "        valid_users = df[df['target'] == 1]['visitorid'].unique()\n",
        "        user_id = np.random.choice(valid_users)\n",
        "    else:\n",
        "        user_id = specific_user_id\n",
        "\n",
        "    user_data = df[df['visitorid'] == user_id].copy()\n",
        "    if len(user_data) == 0:\n",
        "        print(f\"Error: User {user_id} not found in the dataset.\")\n",
        "        return\n",
        "\n",
        "    target_row = user_data.iloc[-1]\n",
        "    history_seq = [int(target_row['item_minus_3']), int(target_row['item_minus_2']), int(target_row['item_minus_1'])]\n",
        "    history_seq = [i for i in history_seq if i != 0] # Clean up zeros\n",
        "\n",
        "    tod_idx = int(target_row['time_of_day_idx'])\n",
        "    time_map = {0: \"Morning\", 1: \"Afternoon\", 2: \"Evening\", 3: \"Night\"}\n",
        "    day_type = \"🎉 Weekend\" if target_row['is_weekend'] else \"💼 Weekday\"\n",
        "\n",
        "    print(\"═\"*70)\n",
        "    print(f\" THE GRANDMASTER X-RAY : DECODING USER #{user_id}\")\n",
        "    print(\"═\"*70)\n",
        "    print(\"\\n[1]  BEHAVIORAL PROFILE & CONTEXT:\")\n",
        "    print(f\"  • Visitor ID         : {user_id}\")\n",
        "    print(f\"  • Recent Search Flow : User previously viewed -> {history_seq}\")\n",
        "    print(f\"  • Environment        : {time_map.get(tod_idx, 'Unknown')}, {day_type}\")\n",
        "\n",
        "    all_items = df['itemid'].unique()\n",
        "    candidates = np.random.choice(all_items, size=pool_size, replace=False)\n",
        "    print(f\"\\n[2]  GENERATING TOP 10 RECOMMENDATIONS (Scanning {pool_size} candidates)...\")\n",
        "\n",
        "    def get_batch_input(mask_type):\n",
        "        iso_input = {\n",
        "            'user_id': np.repeat(user_id, pool_size),\n",
        "            'target_item_id': candidates,\n",
        "            'item_sequence': np.tile([target_row['item_minus_3'], target_row['item_minus_2'], target_row['item_minus_1']], (pool_size, 1)),\n",
        "            'time_of_day': np.repeat(tod_idx, pool_size),\n",
        "            'is_weekend': np.repeat(target_row['is_weekend'], pool_size),\n",
        "            'hour_sin': np.repeat(target_row['hour_sin'], pool_size),\n",
        "            'hour_cos': np.repeat(target_row['hour_cos'], pool_size)\n",
        "        }\n",
        "\n",
        "        if mask_type == \"collab\":\n",
        "            iso_input['item_sequence'] = np.zeros_like(iso_input['item_sequence'])\n",
        "            iso_input['time_of_day'] = np.zeros_like(iso_input['time_of_day'])\n",
        "            iso_input['hour_sin'] = np.zeros_like(iso_input['hour_sin'])\n",
        "            iso_input['hour_cos'] = np.zeros_like(iso_input['hour_cos'])\n",
        "            iso_input['is_weekend'] = np.zeros_like(iso_input['is_weekend'])\n",
        "\n",
        "        elif mask_type == \"content\":\n",
        "            iso_input['user_id'] = np.zeros_like(iso_input['user_id'])\n",
        "            iso_input['time_of_day'] = np.zeros_like(iso_input['time_of_day'])\n",
        "            iso_input['hour_sin'] = np.zeros_like(iso_input['hour_sin'])\n",
        "            iso_input['hour_cos'] = np.zeros_like(iso_input['hour_cos'])\n",
        "            iso_input['is_weekend'] = np.zeros_like(iso_input['is_weekend'])\n",
        "\n",
        "        return iso_input\n",
        "\n",
        "    prob_hybrid = model.predict(get_batch_input(\"full\"), verbose=0).flatten() * 100\n",
        "    prob_collab = model.predict(get_batch_input(\"collab\"), verbose=0).flatten() * 100\n",
        "    prob_content = model.predict(get_batch_input(\"content\"), verbose=0).flatten() * 100\n",
        "\n",
        "    top10_hybrid_idx = np.argsort(prob_hybrid)[::-1][:10]\n",
        "    top10_collab_idx = np.argsort(prob_collab)[::-1][:10]\n",
        "    top10_content_idx = np.argsort(prob_content)[::-1][:10]\n",
        "\n",
        "    def print_top10(title, indices, probabilities):\n",
        "        print(f\"\\n {title}\")\n",
        "        print(\"  Rank | Item ID | Confidence %\")\n",
        "        print(\"  \" + \"-\"*30)\n",
        "        for rank, idx in enumerate(indices):\n",
        "            print(f\"  #{rank+1:<3} | {candidates[idx]:<7} | {probabilities[idx]:.2f}%\")\n",
        "\n",
        "    print_top10(\"CONTENT ONLY (Based strictly on user's recent clicks)\", top10_content_idx, prob_content)\n",
        "    print_top10(\"COLLABORATIVE ONLY (Based strictly on Similar Users' choices)\", top10_collab_idx, prob_collab)\n",
        "    print_top10(\"THE HYBRID ENGINE (Sequence + Collab + Time Context)\", top10_hybrid_idx, prob_hybrid)\n",
        "\n",
        "    print(\"\\n\" + \"═\"*70)\n",
        "\n",
        "grandmaster_top10_xray(df=df_events_context, model=loaded_master_model, specific_user_id=None)"
