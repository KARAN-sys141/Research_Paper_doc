        "import tensorflow as tf\n",
        "from tensorflow.keras import Input, Model\n",
        "from tensorflow.keras import layers\n",
        "from tensorflow.keras.callbacks import EarlyStopping, ModelCheckpoint, ReduceLROnPlateau\n",
        "import keras_tuner as kt\n",
        "\n",
        "NUM_USERS = 1500000\n",
        "NUM_ITEMS = 500000\n",
        "EMBEDDING_DIM = 64\n",
        "\n",
        "def build_optimized_model(hp):\n",
        "    user_input = Input(shape=(1,), name=\"user_id\")\n",
        "    item_input = Input(shape=(1,), name=\"target_item_id\")\n",
        "    seq_input = Input(shape=(3,), name=\"item_sequence\")\n",
        "    tod_input = Input(shape=(1,), name=\"time_of_day\")\n",
        "    weekend_input = Input(shape=(1,), name=\"is_weekend\")\n",
        "    hour_sin_input = Input(shape=(1,), name=\"hour_sin\")\n",
        "    hour_cos_input = Input(shape=(1,), name=\"hour_cos\")\n",
        "\n",
        "    user_emb = layers.Embedding(NUM_USERS, EMBEDDING_DIM)(user_input)\n",
        "    item_emb_layer = layers.Embedding(NUM_ITEMS, EMBEDDING_DIM)\n",
        "    item_emb = item_emb_layer(item_input)\n",
        "    seq_emb = item_emb_layer(seq_input)\n",
        "    tod_emb = layers.Embedding(4, 16)(tod_input)\n",
        "\n",
        "    user_vec = layers.Flatten()(user_emb)\n",
        "    item_vec = layers.Flatten()(item_emb)\n",
        "    seq_vec = layers.GlobalAveragePooling1D()(seq_emb)\n",
        "    tod_vec = layers.Flatten()(tod_emb)\n",
        "\n",
        "    t1 = layers.Concatenate()([user_vec, item_vec])\n",
        "    t1_units = hp.Int('t1_units', min_value=64, max_value=128, step=32)\n",
        "    t1 = layers.Dense(t1_units, activation='relu')(t1)\n",
        "    t1 = layers.BatchNormalization()(t1)\n",
        "\n",
        "    t2_units = hp.Int('t2_units', min_value=32, max_value=64, step=16)\n",
        "    t2 = layers.Dense(t2_units, activation='relu')(seq_vec)\n",
        "    t2 = layers.BatchNormalization()(t2)\n",
        "\n",
        "    t3 = layers.Concatenate()([tod_vec, layers.Dense(8, activation='relu')(weekend_input), hour_sin_input, hour_cos_input])\n",
        "    t3_units = hp.Int('t3_units', min_value=16, max_value=32, step=16)\n",
        "    t3 = layers.Dense(t3_units, activation='relu')(t3)\n",
        "    t3 = layers.BatchNormalization()(t3)\n",
        "\n",
        "    merged = layers.Concatenate()([t1, t2, t3])\n",
        "\n",
        "    fusion_units_1 = hp.Choice('fusion_units_1', values=[128, 256])\n",
        "    x = layers.Dense(fusion_units_1, activation='relu')(merged)\n",
        "    x = layers.BatchNormalization()(x)\n",
        "    x = layers.Dropout(hp.Float('dropout_1', min_value=0.2, max_value=0.4, step=0.1))(x)\n",
        "\n",
        "    fusion_units_2 = hp.Choice('fusion_units_2', values=[64, 128])\n",
        "    x = layers.Dense(fusion_units_2, activation='relu')(x)\n",
        "    x = layers.BatchNormalization()(x)\n",
        "    x = layers.Dropout(hp.Float('dropout_2', min_value=0.1, max_value=0.3, step=0.1))(x)\n",
        "\n",
        "    output = layers.Dense(1, activation='sigmoid', name='buy_probability')(x)\n",
        "\n",
        "    model = Model(\n",
        "        inputs=[user_input, item_input, seq_input, tod_input, weekend_input, hour_sin_input, hour_cos_input],\n",
        "        outputs=output,\n",
        "        name=\"Context_Intent_Engine_AutoML\"\n",
        "    )\n",
        "\n",
        "    lr = hp.Choice('learning_rate', values=[1e-3, 5e-4, 1e-4])\n",
        "    model.compile(\n",
        "        optimizer=tf.keras.optimizers.Adam(learning_rate=lr),\n",
        "        loss='binary_crossentropy',\n",
        "        metrics=['accuracy', tf.keras.metrics.AUC(name='auc')]\n",
        "    )\n",
        "\n",
        "    return model\n",
        "\n",
        "tuner = kt.Hyperband(\n",
        "    build_optimized_model,\n",
        "    objective=kt.Objective(\"val_auc\", direction=\"max\"),\n",
        "    max_epochs=10,\n",
        "    factor=3,\n",
        "    directory='recsys_tuning_logs',\n",
        "    project_name='context_aware_ecommerce'\n",
        ")\n",
        "\n",
        "imbalance_weights = {0: 1.0, 1: 24.0}\n",
        "print(f\"Class Weights explicitly defined: {imbalance_weights}\")\n",
        "\n",
