        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.model_selection import train_test_split\n",
        "import tensorflow as tf\n",
        "from tensorflow.keras.callbacks import EarlyStopping, ReduceLROnPlateau, ModelCheckpoint\n",
        "import keras_tuner as kt\n",
        "\n",
        "print(f\"Loading all {len(df_events_context)} rows without any down-sampling...\")\n",
        "\n",
        "X_dict_full = {\n",
        "    'user_id': df_events_context['visitorid'].values,\n",
        "    'target_item_id': df_events_context['itemid'].values,\n",
        "    'item_sequence': df_events_context[['item_minus_3', 'item_minus_2', 'item_minus_1']].values,\n",
        "    'time_of_day': df_events_context['time_of_day_idx'].values,\n",
        "    'is_weekend': df_events_context['is_weekend'].values,\n",
        "    'hour_sin': df_events_context['hour_sin'].values,\n",
        "    'hour_cos': df_events_context['hour_cos'].values\n",
        "}\n",
        "y_full = df_events_context['target'].values\n",
        "\n",
        "indices = np.arange(len(y_full))\n",
        "train_idx, val_idx = train_test_split(indices, test_size=0.2, random_state=42, stratify=y_full)\n",
        "\n",
        "X_train_full = {key: val[train_idx] for key, val in X_dict_full.items()}\n",
        "y_train_full = y_full[train_idx]\n",
        "X_val_full = {key: val[val_idx] for key, val in X_dict_full.items()}\n",
        "y_val_full = y_full[val_idx]\n",
        "\n",
        "hp_final = kt.HyperParameters()\n",
        "final_robust_model = build_regularized_model(hp_final)\n",
        "\n",
        "callbacks_list_full = [\n",
        "    EarlyStopping(monitor='val_auc', mode='max', patience=2, restore_best_weights=True, verbose=1),\n",
        "    ReduceLROnPlateau(monitor='val_auc', mode='max', factor=0.5, patience=1, verbose=1),\n",
        "    ModelCheckpoint(filepath='master_context_model.keras', monitor='val_auc', mode='max', save_best_only=True, verbose=1)\n",
        "]\n",
        "\n",
        "history_full = final_robust_model.fit(\n",
        "    x=X_train_full, y=y_train_full,\n",
        "    validation_data=(X_val_full, y_val_full),\n",
        "    epochs=5,\n",
        "    batch_size=2048,\n",
        "    callbacks=callbacks_list_full,\n",
        "    verbose=1\n",
        ")\n",
        "\n",
        "plt.style.use('dark_background')\n",
        "fig, axs = plt.subplots(1, 2, figsize=(14, 5))\n",
        "\n",
        "axs[0].plot(history_full.history['loss'], label='Train Loss', color='#00ffcc', linewidth=2)\n",
        "axs[0].plot(history_full.history['val_loss'], label='Val Loss', color='#ff0066', linewidth=2)\n",
        "axs[0].set_title('Master Model Loss (Focal Loss on Full Data)')\n",
        "axs[0].set_xlabel('Epochs')\n",
        "axs[0].legend()\n",
        "\n",
        "axs[1].plot(history_full.history['auc'], label='Train AUC', color='#00ffcc', linewidth=2)\n",
        "axs[1].plot(history_full.history['val_auc'], label='Val AUC', color='#ff0066', linewidth=2)\n",
        "axs[1].set_title('Master Model AUC')\n",
        "axs[1].set_xlabel('Epochs')\n",
        "axs[1].legend()\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
