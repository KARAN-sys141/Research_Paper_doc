      "source": [
        "import tensorflow as tf\n",
        "from tensorflow.keras import Input, Model\n",
        "from tensorflow.keras import layers\n",
        "from tensorflow.keras.regularizers import l2\n",
        "from tensorflow.keras.callbacks import EarlyStopping, ModelCheckpoint, ReduceLROnPlateau\n",
        "import keras_tuner as kt\n",
        "\n",
        "def build_regularized_model(hp):\n",
        "    user_input = Input(shape=(1,), name=\"user_id\")\n",
        "    item_input = Input(shape=(1,), name=\"target_item_id\")\n",
        "    seq_input = Input(shape=(3,), name=\"item_sequence\")\n",
        "    tod_input = Input(shape=(1,), name=\"time_of_day\")\n",
        "    weekend_input = Input(shape=(1,), name=\"is_weekend\")\n",
        "    hour_sin_input = Input(shape=(1,), name=\"hour_sin\")\n",
        "    hour_cos_input = Input(shape=(1,), name=\"hour_cos\")\n",
        "\n",
        "    user_emb = layers.Embedding(NUM_USERS, 32)(user_input)\n",
        "    item_emb_layer = layers.Embedding(NUM_ITEMS, 32)\n",
        "    item_emb = item_emb_layer(item_input)\n",
        "    seq_emb = item_emb_layer(seq_input)\n",
        "    tod_emb = layers.Embedding(4, 8)(tod_input)\n",
        "\n",
        "    user_vec = layers.Flatten()(user_emb)\n",
        "    item_vec = layers.Flatten()(item_emb)\n",
        "    seq_vec = layers.GlobalAveragePooling1D()(seq_emb)\n",
        "    tod_vec = layers.Flatten()(tod_emb)\n",
        "\n",
        "    t1 = layers.Concatenate()([user_vec, item_vec])\n",
        "    t1_units = hp.Int('t1_units', min_value=32, max_value=64, step=16)\n",
        "    t1 = layers.Dense(t1_units, activation='relu', kernel_regularizer=l2(0.001))(t1)\n",
        "    t1 = layers.BatchNormalization()(t1)\n",
        "\n",
        "    t2_units = hp.Int('t2_units', min_value=16, max_value=32, step=16)\n",
        "    t2 = layers.Dense(t2_units, activation='relu', kernel_regularizer=l2(0.001))(seq_vec)\n",
        "    t2 = layers.BatchNormalization()(t2)\n",
        "\n",
        "    t3 = layers.Concatenate()([tod_vec, layers.Dense(8, activation='relu')(weekend_input), hour_sin_input, hour_cos_input])\n",
        "    t3 = layers.Dense(16, activation='relu', kernel_regularizer=l2(0.001))(t3)\n",
        "    t3 = layers.BatchNormalization()(t3)\n",
        "\n",
        "    merged = layers.Concatenate()([t1, t2, t3])\n",
        "\n",
        "    fusion_units_1 = hp.Choice('fusion_units_1', values=[64, 128])\n",
        "    x = layers.Dense(fusion_units_1, activation='relu', kernel_regularizer=l2(0.001))(merged)\n",
        "    x = layers.BatchNormalization()(x)\n",
        "    x = layers.Dropout(hp.Float('dropout_1', min_value=0.3, max_value=0.5, step=0.1))(x)\n",
        "\n",
        "    fusion_units_2 = hp.Choice('fusion_units_2', values=[32, 64])\n",
        "    x = layers.Dense(fusion_units_2, activation='relu', kernel_regularizer=l2(0.001))(x)\n",
        "    x = layers.BatchNormalization()(x)\n",
        "    x = layers.Dropout(hp.Float('dropout_2', min_value=0.2, max_value=0.4, step=0.1))(x)\n",
        "\n",
        "    output = layers.Dense(1, activation='sigmoid', name='buy_probability')(x)\n",
        "\n",
        "    model = Model(\n",
        "        inputs=[user_input, item_input, seq_input, tod_input, weekend_input, hour_sin_input, hour_cos_input],\n",
        "        outputs=output,\n",
        "        name=\"Context_Intent_Engine_Regularized\"\n",
        "    )\n",
        "\n",
        "    lr = hp.Choice('learning_rate', values=[1e-3, 5e-4])\n",
        "\n",
        "    focal_loss = tf.keras.losses.BinaryFocalCrossentropy(gamma=2.0, alpha=0.25)\n",
        "\n",
        "    model.compile(\n",
        "        optimizer=tf.keras.optimizers.Adam(learning_rate=lr),\n",
        "        loss=focal_loss,\n",
        "        metrics=['accuracy', tf.keras.metrics.AUC(name='auc')]\n",
        "    )\n",
        "\n",
        "    return model\n",
        "\n",
        "hp_reg = kt.HyperParameters()\n",
        "optimized_model = build_regularized_model(hp_reg)\n",
        "\n",
        "callbacks_list_reg = [\n",
        "    EarlyStopping(monitor='val_auc', mode='max', patience=3, restore_best_weights=True, verbose=1),\n",
        "    ReduceLROnPlateau(monitor='val_auc', mode='max', factor=0.5, patience=1, verbose=1),\n",
        "    ModelCheckpoint(filepath='robust_context_model.keras', monitor='val_auc', mode='max', save_best_only=True, verbose=1)\n",
        "]\n",
        "\n",
        "history_reg = optimized_model.fit(\n",
        "    x=X_train,\n",
        "    y=y_train,\n",
        "    validation_data=(X_val, y_val),\n",
        "    epochs=5,\n",
        "    batch_size=1024,\n",
        "    callbacks=callbacks_list_reg,\n",
        "    verbose=1\n",
        ")\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "plt.style.use('dark_background')\n",
        "fig, axs = plt.subplots(1, 2, figsize=(14, 5))\n",
        "\n",
        "axs[0].plot(history_reg.history['loss'], label='Train Loss', color='#00ffcc')\n",
        "axs[0].plot(history_reg.history['val_loss'], label='Val Loss', color='#ff0066')\n",
        "axs[0].set_title('Robust Model Loss (Focal Loss + L2)')\n",
        "axs[0].set_xlabel('Epochs')\n",
        "axs[0].legend()\n",
        "\n",
        "axs[1].plot(history_reg.history['auc'], label='Train AUC', color='#00ffcc')\n",
        "axs[1].plot(history_reg.history['val_auc'], label='Val AUC', color='#ff0066')\n",
        "axs[1].set_title('Robust Model AUC')\n",
        "axs[1].set_xlabel('Epochs')\n",
        "axs[1].legend()\n",
        "\n",
        "plt.show()"
